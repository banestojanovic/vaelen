#!/usr/bin/env python3
"""Project-local pstack bootstrap and worktree/receipt bookkeeping; no model SDK."""
import argparse
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile

PIN = "0b8e952052d482ee6de06deebf14d590d77b1b34"
VERSION = "0.15.26"
UPSTREAM = "https://github.com/cursor/plugins.git"
SECTIONS = ("GOAL", "SCOPE", "CONTEXT", "ACCEPTANCE", "VERIFY", "TIMEBOX", "FORBIDDEN", "REPORT", "STANDING")
PASS = {"unit-test-verified", "live-ui-verified"}


def command(*args, cwd=None):
    return subprocess.check_output(args, cwd=cwd, text=True, stderr=subprocess.PIPE).strip()


def git(root, *args):
    return command("git", "-C", str(root), *args)


def fail(message):
    raise ValueError(message)


def name(value):
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,47}", value):
        fail("Names must be lowercase letters/digits/hyphens, starting with a letter (max 48).")
    return value


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        json.dump(value, stream, indent=2)
        stream.write("\n")
        temp = stream.name
    os.replace(temp, path)


def read(path):
    return json.loads(path.read_text())


def clean(root):
    if git(root, "status", "--porcelain"):
        fail(f"Checkout must be clean for exact-SHA verification/integration: {root}")


def head(root):
    return git(root, "rev-parse", "HEAD")


def scope_path(value):
    if not value or value.startswith(("/", ".git", ".build")) or ".." in Path(value).parts:
        fail(f"Scope must be a repository-relative product path: {value}")
    if any(character in value for character in "*?[]"):
        fail(f"Scope must be a literal file/directory path, not a glob: {value}")
    return value.rstrip("/")


def owns(pattern, path):
    return path == pattern or path.startswith(pattern + "/")


def paths(unit):
    root = unit["worktree"]
    changed = git(root, "diff", "--no-renames", "--name-only", unit["base"], "--").splitlines()
    changed += git(root, "ls-files", "--others", "--exclude-standard").splitlines()
    return sorted(set(changed))


def check_scope(unit):
    changed = paths(unit)
    outside = [p for p in changed if not any(owns(s, p) for s in unit["scope"])]
    if outside:
        fail("Changes outside assigned scope: " + ", ".join(outside))
    return changed


@contextlib.contextmanager
def board_at(root, program):
    directory = root / ".build/agent-orchestration" / name(program)
    if not (directory / "board.json").exists():
        fail("Program not initialized. Use init first.")
    with (directory / "lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        board = read(directory / "board.json")
        yield directory, board
        save(directory / "board.json", board)


def bootstrap(root):
    destination = root / ".build/agent-tools/pstack"
    destination.parent.mkdir(parents=True, exist_ok=True)
    with (destination.parent / "bootstrap.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if destination.exists():
            if head(destination) != PIN or git(destination, "status", "--porcelain"):
                fail("Existing upstream checkout differs or is dirty; preserve and inspect it manually.")
        else:
            temporary = Path(tempfile.mkdtemp(prefix="pstack-fetch-", dir=destination.parent))
            try:
                git(temporary, "init", "-q")
                git(temporary, "remote", "add", "origin", UPSTREAM)
                git(temporary, "sparse-checkout", "init", "--cone")
                git(temporary, "sparse-checkout", "set", "pstack", "harness/pstack")
                git(temporary, "fetch", "--quiet", "--depth=1", "origin", PIN)
                git(temporary, "checkout", "--quiet", "--detach", "FETCH_HEAD")
                if head(temporary) != PIN:
                    fail("Fetched upstream revision does not match pin.")
                os.replace(temporary, destination)
            finally:
                if temporary.exists():
                    shutil.rmtree(temporary)
        manifest = read(destination / "pstack/.cursor-plugin/plugin.json")
        if manifest.get("version") != VERSION:
            fail("Pinned plugin version mismatch.")
    print(json.dumps({"upstream": str(destination), "commit": PIN, "version": VERSION}))


def create(root, directory, board, args):
    unit_id = name(args.unit)
    if unit_id in board["units"]:
        fail("Unit already exists; inspect it rather than overwriting its work.")
    scopes = [scope_path(p) for p in args.scope]
    for existing in board["units"].values():
        if existing["state"] in {"integrated", "abandoned"}:
            continue
        if any(owns(a, b) or owns(b, a) for a in scopes for b in existing["scope"]):
            fail("Scope overlaps an unfinished unit; serialize or split ownership.")
    brief = Path(args.brief).resolve().read_text()
    missing = [section for section in SECTIONS if not re.search(r"(?m)^" + section + r"\b", brief)]
    if missing:
        fail("Brief missing sections: " + ", ".join(missing))
    base = git(root, "rev-parse", args.base + "^{commit}")
    worktree = root / ".build/agent-worktrees" / board["program"] / unit_id
    branch = "codex/orch-" + board["program"] + "-" + unit_id
    worktree.parent.mkdir(parents=True, exist_ok=True)
    git(root, "worktree", "add", "-b", branch, str(worktree), base)
    brief_path = directory / "briefs" / (unit_id + ".md")
    brief_path.parent.mkdir(parents=True, exist_ok=True)
    brief_path.write_text(brief + f"\nASSIGNMENT\nBase: {base}\nWorktree: {worktree}\nBranch: {branch}\nOwned paths: {', '.join(scopes)}\nPinned upstream: {root / '.build/agent-tools/pstack/pstack'}\n")
    board["units"][unit_id] = {"id": unit_id, "state": "planned", "scope": scopes,
        "base": base, "branch": branch, "worktree": str(worktree), "brief": str(brief_path),
        "attempt": 0, "runs": [], "ledger": []}
    print(json.dumps(board["units"][unit_id]))


def launch(root, directory, board, args):
    unit = board["units"][args.unit]
    if unit["state"] == "running":
        fail("Unit already has an active run; collect its receipt first.")
    if unit["attempt"] >= 3:
        fail("Three runs exhausted; record the failure and re-scope a fresh unit rather than looping.")
    if sum(u["state"] == "running" for u in board["units"].values()) >= board["window"]:
        fail("Rolling worker window is full; collect a completion before refilling.")
    role = "vaelen-" + args.role
    if not (Path(unit["worktree"]) / ".opencode/agents" / (role + ".md")).exists():
        fail("Agent definition absent from assigned base; commit the adapter before a write trial.")
    if git(unit["worktree"], "branch", "--show-current") != unit["branch"]:
        fail("Assigned worktree branch changed; inspect before launching.")
    check_scope(unit)
    native = shutil.which(args.binary)
    if not native:
        fail("OpenCode binary not found: " + args.binary)
    argv = [native, "run", "--standalone", "--agent", role, "--format", "json", "--file", unit["brief"],
            "Complete the attached scoped brief. Read .opencode/pstack-adapter.md first. Return an honest report; do not commit or use installed Vaelen."]
    if args.role == "reviewer":
        argv[-1] = "Independently verify the attached unit at its current exact HEAD. Read .opencode/pstack-adapter.md. Do not edit, commit, or use installed Vaelen. Report commands, findings, exact SHA, and a verdict."
    if not args.execute:
        print(json.dumps({"cwd": unit["worktree"], "argv": argv, "executes_model": False}))
        return
    unit["attempt"] += 1
    receipt = directory / "runs" / f"{unit['id']}-{unit['attempt']}.json"
    receipt.parent.mkdir(parents=True, exist_ok=True)
    spec = receipt.with_suffix(".spec.json")
    save(spec, {"argv": argv, "cwd": unit["worktree"], "timeout": args.timeout,
                "receipt": str(receipt), "log": str(receipt.with_suffix(".log"))})
    process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_run", str(spec)],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, start_new_session=True)
    unit.update(state="running", pid=process.pid)
    unit["runs"].append({"role": args.role, "receipt": str(receipt), "started": now()})
    print(json.dumps({"unit": unit["id"], "pid": process.pid, "receipt": str(receipt)}))


def run_spec(path):
    spec = read(Path(path))
    result = {"started": now(), "cwd": spec["cwd"], "status": "failed"}
    try:
        with open(spec["log"], "w") as log:
            process = subprocess.Popen(spec["argv"], cwd=spec["cwd"], stdin=subprocess.DEVNULL,
                                       stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            try:
                code = process.wait(timeout=spec["timeout"])
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait()
                code = 124
            result.update(exit_code=code, status="returned" if code == 0 else "failed")
        result["head"] = head(spec["cwd"])
    except Exception as error:
        result["error"] = str(error)
    result["finished"] = now()
    save(Path(spec["receipt"]), result)


def collect(board):
    for unit in board["units"].values():
        if unit["state"] == "running" and Path(unit["runs"][-1]["receipt"]).exists():
            result = read(Path(unit["runs"][-1]["receipt"]))
            unit["state"] = "needs-review" if result["status"] == "returned" else "failed"
            unit["last_result"] = result


def verify(directory, board, args):
    unit = board["units"][args.unit]
    if unit["state"] == "running":
        fail("Collect the active run's terminal receipt before recording verification.")
    clean(unit["worktree"])
    current = head(unit["worktree"])
    if args.head != current:
        fail("Verification head is stale; provide the exact current committed SHA.")
    check_scope(unit)
    report = Path(args.report).resolve()
    text = report.read_text()
    if current not in text:
        fail("Independent report must identify this exact SHA.")
    if args.reviewer == args.unit:
        fail("Reviewer identity must differ from implementation unit/session.")
    entry = {"head": current, "verdict": args.verdict, "reviewer": args.reviewer,
             "report": str(report), "report_sha256": hashlib.sha256(text.encode()).hexdigest(),
             "checks": args.check, "at": now()}
    receipt = directory / "verification" / (unit["id"] + "-" + str(len(unit["ledger"]) + 1) + ".md")
    receipt.parent.mkdir(parents=True, exist_ok=True)
    receipt.write_text(text)
    entry["report"] = str(receipt)
    unit["ledger"].append(entry)
    unit["state"] = "verified" if args.verdict in PASS else args.verdict
    print(json.dumps(entry))


def integrate(root, board, args):
    if args.owner != board["integration_owner"]:
        fail("Only the program's named integration owner may integrate.")
    unit = board["units"][args.unit]
    if unit["state"] != "verified":
        fail("Unit is not in verified state; finish current work/review before integration.")
    clean(root)
    clean(unit["worktree"])
    current = head(unit["worktree"])
    if not unit["ledger"] or unit["ledger"][-1]["head"] != current or unit["ledger"][-1]["verdict"] not in PASS:
        fail("Current exact head lacks a passing independent verification receipt.")
    check_scope(unit)
    git(root, "merge-base", "--is-ancestor", "HEAD", current)
    if not args.execute:
        print(json.dumps({"integration": str(root), "from": head(root), "to": current, "executes_git_merge": False}))
        return
    git(root, "merge", "--ff-only", current)
    unit.update(state="integrated", integrated_head=head(root), integrated_at=now())
    print(json.dumps({"unit": args.unit, "head": head(root)}))


def status(board):
    def observed_head(unit):
        try:
            return head(unit["worktree"])
        except (OSError, subprocess.CalledProcessError):
            return None
    return {"program": board["program"], "integration_owner": board["integration_owner"],
            "window": board["window"], "units": [{"id": u["id"], "state": u["state"],
            "branch": u["branch"], "head": observed_head(u), "worktree": u["worktree"]}
            for u in board["units"].values()]}


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "_run":
        run_spec(sys.argv[2])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--program", default="vaelen")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("bootstrap", help="Fetch and verify the pinned upstream plugin in ignored build storage")
    init = commands.add_parser("init")
    init.add_argument("--integration-owner", required=True)
    init.add_argument("--window", type=int, choices=range(1, 9), default=3)
    create_parser = commands.add_parser("create", help="Create one isolated writer worktree from a committed base")
    create_parser.add_argument("unit", type=name)
    create_parser.add_argument("--scope", action="append", required=True)
    create_parser.add_argument("--brief", required=True)
    create_parser.add_argument("--base", default="HEAD")
    launch_parser = commands.add_parser("launch", help="Preview a native run; --execute explicitly starts model work")
    launch_parser.add_argument("unit", type=name)
    launch_parser.add_argument("--role", choices=("worker", "reviewer"), default="worker")
    launch_parser.add_argument("--binary", choices=("opencode", "opencode2"), default="opencode2")
    launch_parser.add_argument("--timeout", type=int, choices=range(30, 14401), default=1800)
    launch_parser.add_argument("--execute", action="store_true")
    commands.add_parser("collect", help="Read completed native-run receipts without waking agents")
    commands.add_parser("status")
    commands.add_parser("handoff", help="Print durable state and next actions for another engine/session")
    abandon_parser = commands.add_parser("abandon", help="Close a stopped unit without deleting its worktree or branch")
    abandon_parser.add_argument("unit", type=name)
    abandon_parser.add_argument("--reason", required=True)
    verify_parser = commands.add_parser("record", help="Record independent evidence for a clean exact SHA")
    verify_parser.add_argument("unit", type=name)
    verify_parser.add_argument("--head", required=True)
    verify_parser.add_argument("--reviewer", required=True)
    verify_parser.add_argument("--report", required=True)
    verify_parser.add_argument("--check", action="append", required=True)
    verify_parser.add_argument("--verdict", choices=sorted(PASS | {"type-check-only", "verifier-blocked", "verifier-failed"}), required=True)
    integrate_parser = commands.add_parser("integrate", help="Preview clean fast-forward integration; --execute lands it")
    integrate_parser.add_argument("unit", type=name)
    integrate_parser.add_argument("--owner", required=True)
    integrate_parser.add_argument("--execute", action="store_true")
    args = parser.parse_args()
    root = Path(git(args.repo.resolve(), "rev-parse", "--show-toplevel"))
    if args.command == "bootstrap":
        bootstrap(root)
        return
    if args.command == "init":
        directory = root / ".build/agent-orchestration" / name(args.program)
        directory.mkdir(parents=True, exist_ok=True)
        with (directory / "lock").open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if (directory / "board.json").exists():
                fail("Program already exists; use status/handoff instead of resetting it.")
            save(directory / "board.json", {"program": args.program, "integration": str(root),
                 "integration_owner": args.integration_owner, "window": args.window,
                 "upstream": PIN, "created": now(), "units": {}})
        print(str(directory))
        return
    with board_at(root, args.program) as (directory, board):
        if args.command == "create":
            create(root, directory, board, args)
        elif args.command == "launch":
            launch(root, directory, board, args)
        elif args.command in {"collect", "status", "handoff"}:
            if args.command == "collect":
                collect(board)
            output = status(board)
            if args.command == "handoff":
                output.update(board=str(directory / "board.json"), integration_head=head(root),
                    dirty_integration=bool(git(root, "status", "--porcelain")), runtime_owner="PM only; re-observe before installed operations",
                    next="Collect receipts; inspect unit diffs/reports; verify current SHAs; integrate only with named owner and authorization.")
            print(json.dumps(output, indent=2))
        elif args.command == "record":
            verify(directory, board, args)
        elif args.command == "integrate":
            integrate(root, board, args)
        elif args.command == "abandon":
            unit = board["units"][args.unit]
            if unit["state"] in {"running", "integrated"}:
                fail("Cannot abandon an active or integrated unit; inspect its actual lifecycle first.")
            unit.update(state="abandoned", reason=args.reason, abandoned_at=now())
            print(json.dumps({"unit": args.unit, "preserved": unit["worktree"]}))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", None) or str(error)
        print("vaelen-agents: " + detail.strip(), file=sys.stderr)
        sys.exit(1)
